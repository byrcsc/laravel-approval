# Environment for the workbench demo app.
#
# Every `vendor/bin/testbench` invocation copies this file into the Testbench
# skeleton as `.env`, and the copy routinely outlives the command that made it.
# The package test suite boots against that same skeleton, so these values have
# to be safe for `composer test` as well as for the demo. CACHE_STORE in
# particular stays on `array`: without this file Testbench falls back to the
# framework's own `.env.example`, which selects `database`, and the suite has no
# `cache_locks` table to lock against.
#
# Nothing the package reads is set here on purpose. `APPROVAL_*` variables would
# reach the test suite through the same stranded copy, and a suite that asserts
# the shipped defaults - notifications off, self-approval refused - would then
# be asserting the demo's settings instead. The demo sets those in
# `WorkbenchServiceProvider`, where they cannot escape.
#
# `composer clear` removes the stranded copy.

APP_ENV=workbench
APP_DEBUG=true

DB_CONNECTION=sqlite

QUEUE_CONNECTION=sync

CACHE_STORE=array
SESSION_DRIVER=array

# Notifications are on in the demo, so every mail lands in the skeleton's log
# rather than anywhere outside it.
MAIL_MAILER=log
